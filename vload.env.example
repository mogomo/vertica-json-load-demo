# -----------------------------------------------------------------------------
#  vload.env — local settings (copy to vload.env; vload.env is git-ignored)
# -----------------------------------------------------------------------------

# --- connection (standard vsql environment variables) ------------------------
VSQL=/opt/vertica/bin/vsql
#VSQL_HOST=localhost
#VSQL_PORT=5433
#VSQL_DATABASE=
#VSQL_USER=dbadmin
#VSQL_PASSWORD=

# Optional: run every demo session in a dedicated resource pool
#RESOURCE_POOL=vload_pool

# --- where things go ----------------------------------------------------------
# The JSON files must be readable by the Vertica server process: run the demo
# on a Vertica node (or put DEMO_DIR on storage every node can read).
#SCHEMA=vload
#DEMO_DIR=./demo
#LOG_DIR=./logs
#REPORT_DIR=./reports
#COPY_NODE_CLAUSE="ON ANY NODE"

# --- the data (generate.sh) ---------------------------------------------------
#BASE_ROWS=1B              # rows of the fact table          (or: --rows)
#CHANGE_ROWS=1M            # JSON changes per table          (or: --changes)
#CHANGE_MIX=50:0:50        # update : delete : insert, in percent
#HOT_PCT=5                 # updates/deletes hit the newest HOT_PCT % of the rows
#START_DATE=2023-01-01     # created_date of ISN 1
#SPAN_DAYS=1096            # 3 years = 36 monthly partitions
#SEED=20260101
#JSON_FILES=auto           # number of change files = COPY parse threads (default: CPUs, max 24)
#GEN_SESSIONS=auto         # parallel INSERT sessions (default: CPUs / 2)

# --- phase 1 (phase1.sh) -------------------------------------------------------
#REBUILD_SESSIONS=auto     # parallel sessions of the swap rebuild (default: GEN_SESSIONS)

# --- phases 2 and 3 (generate_multi.sh, phase2.sh, phase3.sh) ----------------------
#MULTI_ROWS=60M            # rows of each of the 9 other tables     (or: generate_multi.sh --rows)
#PARALLEL=10               # MERGEs running at the same time        (or: --parallel 10,5,1)

# --- presentation -------------------------------------------------------------
#SQL_PREVIEW_LINES=40      # truncate long statements on screen (0 = never)
#PAUSE=0                   # 1 = wait for Enter before each step (same as --pause)
