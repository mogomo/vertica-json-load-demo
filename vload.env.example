# -----------------------------------------------------------------------------
#  vload.env — local settings (copy to vload.env; vload.env is git-ignored)
# -----------------------------------------------------------------------------

# --- connection (standard vsql environment variables) ------------------------
VSQL=/opt/vertica/bin/vsql
#VSQL_HOST=localhost
#VSQL_PORT=5433
#VSQL_DATABASE=
#VSQL_USER=dbadmin
#VSQL_PASSWORD=

# Optional: run all demo sessions in a dedicated resource pool, e.g.
#   CREATE RESOURCE POOL vload_pool MEMORYSIZE '8G' PLANNEDCONCURRENCY 10 MAXCONCURRENCY 12;
#   GRANT USAGE ON RESOURCE POOL vload_pool TO <user>;
#RESOURCE_POOL=vload_pool

# --- where things go ----------------------------------------------------------
# The JSON files must be readable by the Vertica server process: run the demo
# on a Vertica node (or put DATA_DIR on storage every node can read).
#DATA_DIR=./data
#LOG_DIR=./logs
#REPORT_DIR=./reports
#SCHEMA_PREFIX=vload

# "ON ANY NODE" lets every node parse files of a shared DATA_DIR (NFS, etc.).
# Use "" on a multi-node cluster when DATA_DIR is local to the initiator only.
#COPY_NODE_CLAUSE="ON ANY NODE"

# One COPY per table and stream is fastest. On a small disk, split huge loads
# into consecutive COPYs of N files: every batch is sorted and committed on its
# own, so the TEMP space needed while sorting is ~1/batches of the load.
# (1B rows with the LAP method on a ~200 GB disk: COPY_BATCH_FILES=2)
#COPY_BATCH_FILES=0
# The LAP journal purge briefly needs the old and the new copy of a table:
# purge fewer tables at a time to lower the disk peak.
#PURGE_PARALLEL=0          # 0 = all tables at once

# --- data generation ----------------------------------------------------------
#COMPRESSION=zstd          # zstd | gzip | none   (1B rows ≈ 57 GB zstd, ≈ 470 GB raw)
#FILES_PER_TABLE=auto      # files per table and stream = COPY parse threads per table
#GEN_JOBS=auto             # parallel generator processes (default: CPU count)
#START_DATE=2023-01-01     # created_date of ISN 1
#SPAN_DAYS=1096            # base data covers 3 years → 36 monthly partitions
#SEED=20260101

# --- CDC doses applied after the base load ------------------------------------
#DOSES=3
#DOSE_PCT=1                # size of a dose, % of the base rows of a table
#DOSE_MIX=60:10:30         # update : delete : insert
#HOT_PCT=5                 # updates/deletes hit the newest HOT_PCT % of the rows

# --- presentation -------------------------------------------------------------
#SQL_PREVIEW_LINES=60      # truncate long statements on screen (0 = never)
#PAUSE=0                   # 1 = wait for Enter before each step (same as --pause)
